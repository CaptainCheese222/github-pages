<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hello World</title>
    <style>
        #blueBox {
            width: 300px;
            height: 150px;
            background-color: blue;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <h1>Hello World</h1>

    <button onclick="changeFontSize()">Increase font</button>
    <button onclick="toggleFontColor()">Change Font Colour</button>

    <div id="blueBox"></div>

    <script>
        function changeFontSize() {
            const body = document.body;
            const currentFontSize = parseInt(window.getComputedStyle(body).fontSize);
            body.style.fontSize = (currentFontSize + 2) + 'px';
        }

        function toggleFontColor() {
            const body = document.body;
            body.style.color = (body.style.color === 'green') ? 'black' : 'green';
        }
    </script>

</body>
</html>
